\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tikzflora}[2026/10/30 Procedural watercolor botanical margins]

\RequirePackage{iftex}
\ifluatex\else
  \PackageError{tikzflora}{tikzflora needs LuaLaTeX}{Compile with lualatex.}
\fi
\RequirePackage{tikz}

% The generator lives in lua/flora/*.lua; the boot file makes it reachable
% from the repository root without installing anything.
\directlua{dofile(kpse.find_file("tikzflora-boot.lua", "tex"))}

% Document seed: a number, or "random" to draw new flora on every run.
\providecommand\florseed{1}
% A page number to draw flora on that page only (empty: every page). The
% tuner uses it to recompile one page quickly.
\providecommand\florapages{}

% Draw the specimen sheet inside the current tikzpicture.
\newcommand\florasheet[1]{\directlua{flora.specimens(#1)}}

% Every shipped page gets a page-sized picture behind its content. Geometry
% is read at shipout, so per-page layout changes are honoured.
\newif\iffloraon \floraontrue
\newcommand\floraoff{\global\floraonfalse}
\newcommand\floraon{\global\floraontrue}

\AddToHook{shipout/background}{%
  \iffloraon
    \put(0pt,-\paperheight){\directlua{flora.page{
      width = "\the\paperwidth", height = "\the\paperheight",
      text_x0 = "\the\dimexpr 1in+\hoffset+\oddsidemargin\relax",
      text_x1 = "\the\dimexpr 1in+\hoffset+\oddsidemargin+\textwidth\relax",
      text_y1 = "\the\dimexpr\paperheight-1in-\voffset-\topmargin-\headheight-\headsep\relax",
      text_y0 = "\the\dimexpr\paperheight-1in-\voffset-\topmargin-\headheight-\headsep-\textheight\relax",
      header_y = "\the\dimexpr\paperheight-1in-\voffset-\topmargin-\headheight\relax",
      seed = "\florseed", page = \the\value{page}, box = \number\ShipoutBox,
      only = "\florapages",
    }}}%
  \fi
}
